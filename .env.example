# Public URLs
PUBLIC_BASE_URL=https://mail.example.com
MAILCOW_BASE_URL=https://mail.example.com
MAILCOW_INTERNAL_URL=https://nginx-mailcow:443
MAILCOW_INTERNAL_TLS_VERIFY=1

# Existing Mailcow superadmin. Never put the password here.
MAILCOW_ADMIN_USERNAME=replace-me

# Exact production address: 95.32.153.147/32
TRUSTED_ADMIN_CIDRS=95.32.153.147/32
# Requests reach the container through local nginx/Docker.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,172.16.0.0/12

# Existing Mailcow containers on the external Docker network.
MAILCOW_NETWORK=mailcowdockerized_mailcow-network
MAILCOW_DB_HOST=mysql-mailcow
MAILCOW_DB_PORT=3306
MAILCOW_DB_NAME=mailcow
MAILCOW_DB_USER=mailcow
MAILCOW_DB_PASSWORD=replace-me
MAILCOW_REDIS_HOST=redis-mailcow
MAILCOW_REDIS_PORT=6379
MAILCOW_REDIS_PASSWORD=replace-me

# Mailcow UI session settings verified against the installed version.
MAILCOW_SESSION_COOKIE=MCSESSID
MAILCOW_SESSION_PREFIX=PHPREDIS_SESSION:
MAILCOW_SESSION_TTL=10800

# Broker settings
BROKER_SECRET=replace-with-at-least-32-random-bytes
AUDIT_RETENTION_DAYS=90
BROKER_BIND=127.0.0.1
BROKER_PORT=8095

# Local gateway only (docker compose --profile local ...)
LOCAL_HTTPS_BIND=0.0.0.0
LOCAL_HTTPS_PORT=9443

